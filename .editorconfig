# Configuration de l'éditeur, voir https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Le Markdown peut contenir des espaces de fin pour les retours à la ligne.
[*.md]
trim_trailing_whitespace = false

# Les scripts Maven Wrapper Windows gardent leurs fins de ligne.
[*.cmd]
end_of_line = crlf
