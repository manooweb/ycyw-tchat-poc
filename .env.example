# Copier ce fichier en .env puis remplacer « change-me » par un mot de passe de votre choix.
# .env est ignoré par Git : il ne doit jamais être versionné.

# Base PostgreSQL : ces valeurs sont lues par Docker Compose quand il crée la base.
POSTGRES_DB=ycyw_chat
POSTGRES_USER=ycyw
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
